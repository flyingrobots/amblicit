{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/schemas/edict/compiler-settings/v1",
  "title": "Edict Compiler Settings v1",
  "description": "JSONL compiler settings record for the public Edict CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "type", "operation"],
  "properties": {
    "schema": {
      "const": "edict.compiler.settings/v1"
    },
    "type": {
      "const": "compilerSettings"
    },
    "operation": {
      "enum": ["build", "check", "project"]
    },
    "application": {
      "type": "string",
      "minLength": 1,
      "description": "Path to an edict.application/v1 manifest for the build operation."
    },
    "lawpack": {
      "type": "string",
      "minLength": 1,
      "description": "Path to an edict.lawpack-build/v1 document for the build operation."
    },
    "checkOnly": {
      "type": "boolean",
      "default": false,
      "description": "Validate lawpack outputs without writing; valid only with lawpack."
    },
    "emit": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["syntax", "diagnostics", "core", "targetIr", "digests"]
      },
      "uniqueItems": true,
      "description": "Projection slots requested by the `project` operation."
    },
    "compilerContext": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit deterministic compiler facts for Core projection.",
      "properties": {
        "operationProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "core"],
            "properties": {
              "source": { "type": "string" },
              "core": { "type": "string" },
              "allowedWriteClasses": {
                "type": "array",
                "items": {
                  "enum": [
                    "none",
                    "read",
                    "create",
                    "ensure",
                    "append",
                    "replace",
                    "delete"
                  ]
                },
                "default": []
              }
            }
          },
          "default": []
        },
        "effectWriteClasses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "writeClass"],
            "properties": {
              "effect": { "type": "string" },
              "writeClass": {
                "enum": [
                  "none",
                  "read",
                  "create",
                  "ensure",
                  "append",
                  "replace",
                  "delete"
                ]
              }
            }
          },
          "default": []
        },
        "budgets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "budget"],
            "properties": {
              "source": { "type": "string" },
              "budget": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "maxSteps",
                  "maxAllocatedBytes",
                  "maxOutputBytes"
                ],
                "properties": {
                  "maxSteps": { "type": "integer", "minimum": 0 },
                  "maxAllocatedBytes": { "type": "integer", "minimum": 0 },
                  "maxOutputBytes": { "type": "integer", "minimum": 0 }
                }
              }
            }
          },
          "default": []
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "description": "Explicit deterministic target facts for Target IR projection.",
      "required": ["coordinate", "profileDigest", "irDomain"],
      "properties": {
        "coordinate": { "type": "string", "minLength": 1 },
        "profileDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "irDomain": { "type": "string", "minLength": 1 },
        "operationProfiles": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "obstructionCoordinates": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "effectLowerings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["effect", "targetIntrinsic"],
            "properties": {
              "effect": { "type": "string" },
              "targetIntrinsic": { "type": "string" }
            }
          },
          "default": []
        }
      }
    },
    "inputRoot": {
      "type": "string",
      "description": "Optional filesystem root for path, pathList, directory, and glob inputs. When present, every resolved input path must stay within this root."
    },
    "directoryExtensions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\.[A-Za-z0-9_-]+$"
      },
      "uniqueItems": true,
      "default": [".amblicit"]
    },
    "followSymlinks": {
      "type": "boolean",
      "default": false
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": { "const": "check" }
        }
      },
      "then": {
        "properties": {
          "type": { "const": "compilerSettings" },
          "emit": false,
          "compilerContext": false,
          "target": false,
          "application": false,
          "lawpack": false,
          "checkOnly": false
        }
      }
    },
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": { "const": "project" }
        }
      },
      "then": {
        "required": ["emit"],
        "properties": {
          "type": { "const": "compilerSettings" },
          "application": false,
          "lawpack": false,
          "checkOnly": false
        }
      }
    },
    {
      "if": {
        "required": ["operation"],
        "properties": {
          "operation": { "const": "build" }
        }
      },
      "then": {
        "oneOf": [
          { "required": ["application"] },
          { "required": ["lawpack"] }
        ],
        "properties": {
          "type": { "const": "compilerSettings" },
          "emit": false,
          "compilerContext": false,
          "target": false,
          "inputRoot": false,
          "followSymlinks": false,
          "directoryExtensions": false
        },
        "allOf": [{
          "if": { "required": ["checkOnly"] },
          "then": { "required": ["lawpack"] }
        }]
      }
    }
  ]
}
