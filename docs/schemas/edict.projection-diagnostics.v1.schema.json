{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flyingrobots.dev/schemas/edict/projection-diagnostics/v1",
  "title": "Edict Projection Diagnostics v1",
  "description": "JSONL diagnostics projection record emitted by the public Edict CLI `project` operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "type",
    "command",
    "input",
    "diagnostics"
  ],
  "properties": {
    "schema": {
      "const": "edict.projection.diagnostics/v1"
    },
    "type": {
      "const": "diagnostics"
    },
    "command": {
      "const": "project"
    },
    "input": {
      "type": "object"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "kind",
          "severity",
          "span"
        ],
        "properties": {
          "stage": {
            "enum": [
              "lex",
              "parse",
              "surfaceValidation",
              "resolve",
              "typeCheck",
              "lowerCore"
            ]
          },
          "kind": {
            "type": "string"
          },
          "severity": {
            "const": "error"
          },
          "span": {
            "$ref": "#/$defs/span"
          },
          "message": {
            "type": "string"
          },
          "signatureMismatch": {
            "$ref": "#/$defs/signatureMismatch"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "signatureMismatch"
              ]
            },
            "then": {
              "properties": {
                "kind": {
                  "const": "TypeMismatch"
                },
                "stage": {
                  "const": "typeCheck"
                }
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0
        },
        "end": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "signatureMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effect",
        "position",
        "path",
        "expectedType",
        "actualType"
      ],
      "properties": {
        "effect": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "enum": [
            "input",
            "receipt"
          ]
        },
        "path": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "name"
                ],
                "properties": {
                  "kind": {
                    "const": "field"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "listItem",
                      "settlement"
                    ]
                  }
                }
              }
            ]
          }
        },
        "expectedType": {
          "type": [
            "string",
            "null"
          ]
        },
        "actualType": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "anyOf": [
        {
          "properties": {
            "expectedType": {
              "type": "string"
            }
          }
        },
        {
          "properties": {
            "actualType": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
