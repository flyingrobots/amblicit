; edict-target-profile.cddl
; Canonical schema for the Edict target profile manifest.
; Authoritative byte encoding: edict.canonical-cbor/v1
; (see SPEC_continuum-contract-bundle-v1.md). JSON in the prose specs is a
; review rendering generated from this schema; this CDDL is the single source
; of truth (EDICT-ABI-NODUP-001).

target-profile-manifest = {
  apiVersion: "edict.target-profile/v1",
  id: tstr,                         ; e.g. "echo.dpo"
  version: tstr,                    ; e.g. "1"
  acceptedCoreAbi: [+ tstr],        ; e.g. ["edict.core/v1"]

  intrinsics: resource-ref,
  intrinsicNamespace: tstr,
  ; publishes this profile's operation-profile records (optic templates that
  ; `profile`/`implements` clauses resolve against). References an
  ; operation-profiles-document (EDICT-ABI-OPPROFILE-SLOT-001).
  operationProfiles: resource-ref,
  footprintAlgebra: resource-ref,
  costAlgebra: resource-ref,
  targetIr: resource-ref,
  obstructionTaxonomy: resource-ref,
  verifier: resource-ref,
  lowerer: resource-ref,
  sandbox: resource-ref,
  fuelModel: resource-ref,

  ; fields the language spec requires of every profile
  bundleProfile: resource-ref,
  generatedArtifactProfiles: [* resource-ref],
  canonicalEncodingRules: resource-ref,
  ; A profile that accepts the direct declarative lawpack-adapter ABI names it
  ; exactly once. Profiles that do not consume lawpack adapters leave this
  ; optional slot absent or empty.
  ? acceptedLawpackAdapterAbi: [] / ["edict.lawpack-adapter/v1"],
  diagnosticAbi: resource-ref,

  ; application doctrine
  applicationModel: "atomic",
  readConsistency: "application-snapshot" / tstr,
  guardEvaluation: "precommit-atomic" / tstr,
  obstructionRollback: "no-visible-effects" / tstr,
  multiTarget: bool,
  ; whether the target can evaluate precommit postcondition (`guarantee`) checks
  ; inside the atomic application unit (EDICT-TARGET-POSTCOND-001)
  postconditionSupport: bool,

  deterministicExecution: resource-ref,
  conformanceFixtureCorpus: resource-ref,
}

; Shared types resource-ref and sha256-digest are defined once in
; edict-common.cddl and assembled with this schema by the build
; (EDICT-ABI-NODUP-001). They are not redefined here.

; --- intrinsic signature -------------------------------------------------
; The artifact referenced by the manifest's `intrinsics` resource-ref is the
; intrinsic-signature corpus document below. Its layout is fixed so two
; independent profiles validate/hash the corpus identically
; (EDICT-ABI-INTRINSICS-DOC-001).

; intrinsics is a MAP keyed by coordinate, so the schema itself enforces
; coordinate uniqueness. A provider receives the resolved corpus as a
; digest-bound semantic input and resolves coordinates within that artifact.
; Each map key MUST equal its record's `coordinate` field
; (EDICT-ABI-INTRINSIC-UNIQUE-001).
; Catalog v2 (EDICT-TARGET-PURE-INTRINSIC-001): every pure intrinsic in the
; catalog carries a complete monomorphic contract, whether or not a consumer
; requires it. The catalog publishes every provider-owned named type that a
; required pure signature reaches; admission checks that, this schema does not.
; A v1 catalog is not a value of this rule; the publications that admit v1
; are frozen under fixtures/provider-contracts/.
intrinsics-document = intrinsics-document-v2 / intrinsics-document-v3

intrinsics-document-v2 = {
  apiVersion: "edict.target-profile.intrinsics/v2",
  intrinsics: { * tstr => intrinsic },
  ; Provider-owned named types that pure-intrinsic signatures reference, keyed
  ; by a coordinate below the profile id. Each value is a structural
  ; `Record<...>` core-type-ref whose fields are structural types.
  ? types: { * tstr => tstr },
}

; Catalog v3 (#341): catalog v2 plus effect cost templates. Pure contracts
; keep their v2 shape; every effect intrinsic carries a required
; `effectCostRule`. The optional `parameters` map says where each named
; template parameter lives in the operation configuration. The schema fixes
; the shape; admission (`admit_target_effect_costs`) checks depth and path
; syntax and resolves parameters against the configuration; evaluating a
; charge resolves type paths against the effect's signature.
intrinsics-document-v3 = {
  apiVersion: "edict.target-profile.intrinsics/v3",
  intrinsics: { * tstr => intrinsic-v3 },
  ? types: { * tstr => tstr },
  ; At most 64 declarations, the decoder's limit.
  ? parameters: { 0*64 nonempty-text => effect-cost-parameter },
}

intrinsic-v3 = pure-intrinsic / effect-intrinsic-v3

effect-cost-parameter = {
  path: [1*16 nonempty-text],
  kind: "uint" / "helper",
}

; Closed u64 expressions. Expressions, measures and types share one nesting
; level: `steps` and `bytes` are level 0 and each nested expression, measure,
; type or record field is one level deeper. Published depth limit: level 10
; (`TARGET_EFFECT_COST_SCHEMA_MAX_DEPTH`). The rules below are written out
; level by level to that depth, because the provider artifact-schema registry
; refuses these rules when they are recursive. The decoder reads to level 16,
; so the schema is the tighter side: a catalog nested deeper than level 10 is
; refused when its provider package loads, although the decoder would accept
; it. Evaluation refuses overflow. The schema requires `effectCostRule` on
; every effect intrinsic of a v3 catalog, while the compiler reads it only for
; the effects a program uses.
effect-cost-rule = {
  steps: effect-cost-expr-0,
  bytes: effect-cost-expr-0,
}

effect-cost-half = "steps" / "bytes"

; BEGIN GENERATED effect-cost levels (cargo xtask provider-contract-pack --write)
; Do not edit. Level n is the decoder's nesting depth: steps and bytes are
; level 0 and each nested expression, measure, type or record field is one
; level deeper, up to 10. A deeper value has no rule here.
effect-cost-expr-0 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-1] }
                   / { product: [2*2 effect-cost-expr-1] }
                   / { measure: effect-cost-measure-1 }
effect-cost-expr-1 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-2] }
                   / { product: [2*2 effect-cost-expr-2] }
                   / { measure: effect-cost-measure-2 }
effect-cost-expr-2 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-3] }
                   / { product: [2*2 effect-cost-expr-3] }
                   / { measure: effect-cost-measure-3 }
effect-cost-expr-3 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-4] }
                   / { product: [2*2 effect-cost-expr-4] }
                   / { measure: effect-cost-measure-4 }
effect-cost-expr-4 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-5] }
                   / { product: [2*2 effect-cost-expr-5] }
                   / { measure: effect-cost-measure-5 }
effect-cost-expr-5 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-6] }
                   / { product: [2*2 effect-cost-expr-6] }
                   / { measure: effect-cost-measure-6 }
effect-cost-expr-6 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-7] }
                   / { product: [2*2 effect-cost-expr-7] }
                   / { measure: effect-cost-measure-7 }
effect-cost-expr-7 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-8] }
                   / { product: [2*2 effect-cost-expr-8] }
                   / { measure: effect-cost-measure-8 }
effect-cost-expr-8 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-9] }
                   / { product: [2*2 effect-cost-expr-9] }
                   / { measure: effect-cost-measure-9 }
effect-cost-expr-9 = { const: uint }
                   / { sum: [2*16 effect-cost-expr-10] }
                   / { product: [2*2 effect-cost-expr-10] }
                   / { measure: effect-cost-measure-10 }
effect-cost-expr-10 = { const: uint }
effect-cost-measure-1 = { bytesMax: effect-cost-type-2 }
                      / { listMax: effect-cost-type-2 }
                      / { validations: effect-cost-type-2 }
                      / { copy: effect-cost-type-2, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-2 = { bytesMax: effect-cost-type-3 }
                      / { listMax: effect-cost-type-3 }
                      / { validations: effect-cost-type-3 }
                      / { copy: effect-cost-type-3, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-3 = { bytesMax: effect-cost-type-4 }
                      / { listMax: effect-cost-type-4 }
                      / { validations: effect-cost-type-4 }
                      / { copy: effect-cost-type-4, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-4 = { bytesMax: effect-cost-type-5 }
                      / { listMax: effect-cost-type-5 }
                      / { validations: effect-cost-type-5 }
                      / { copy: effect-cost-type-5, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-5 = { bytesMax: effect-cost-type-6 }
                      / { listMax: effect-cost-type-6 }
                      / { validations: effect-cost-type-6 }
                      / { copy: effect-cost-type-6, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-6 = { bytesMax: effect-cost-type-7 }
                      / { listMax: effect-cost-type-7 }
                      / { validations: effect-cost-type-7 }
                      / { copy: effect-cost-type-7, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-7 = { bytesMax: effect-cost-type-8 }
                      / { listMax: effect-cost-type-8 }
                      / { validations: effect-cost-type-8 }
                      / { copy: effect-cost-type-8, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-8 = { bytesMax: effect-cost-type-9 }
                      / { listMax: effect-cost-type-9 }
                      / { validations: effect-cost-type-9 }
                      / { copy: effect-cost-type-9, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-9 = { bytesMax: effect-cost-type-10 }
                      / { listMax: effect-cost-type-10 }
                      / { validations: effect-cost-type-10 }
                      / { copy: effect-cost-type-10, of: effect-cost-half }
                      / { parameter: nonempty-text }
                      / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                      / { costliestHelper: effect-cost-half }
effect-cost-measure-10 = { parameter: nonempty-text }
                       / { helper: { parameter: nonempty-text }, of: effect-cost-half }
                       / { costliestHelper: effect-cost-half }
effect-cost-type-2 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-3 } }
effect-cost-type-3 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-4 } }
effect-cost-type-4 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-5 } }
effect-cost-type-5 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-6 } }
effect-cost-type-6 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-7 } }
effect-cost-type-7 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-8 } }
effect-cost-type-8 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-9 } }
effect-cost-type-9 = { path: effect-cost-path }
                   / { word: null }
                   / { record: { * tstr => effect-cost-type-10 } }
effect-cost-type-10 = { path: effect-cost-path }
                    / { word: null }
                    / { record: {} }
; END GENERATED effect-cost levels

; `path` names a type in the effect's signature (record fields, then `item` list-item
; steps, then optional fields inside the item); `word` is the u64 word and
; `record` a synthesized record. `then` needs at least one item step.
effect-cost-path = {
  side: "input" / "output",
  fields: [* tstr],
  item: uint,
} / {
  side: "input" / "output",
  fields: [* tstr],
  item: uint .ge 1,
  then: [1* tstr],
}

; The artifact referenced by the manifest's `operationProfiles` resource-ref.
; operation-profile / optic-template are defined in edict-common.cddl. Keyed by
; coordinate so resolution can't pick between two same-coordinate profiles
; (EDICT-ABI-OPPROFILE-SLOT-001, EDICT-ABI-OPPROFILE-UNIQUE-001).
operation-profiles-document = {
  apiVersion: "edict.target-profile.operation-profiles/v1",
  profiles: { * tstr => operation-profile },
}

; A typed pre-lowering question that can be proposed by Watson or an agent and
; checked by the compiler. It is canonical-CBOR encoded under
; `edict.lowering-requirements/v1`; the compiler checks this artifact, not the
; prose that produced it.
lowering-requirements = {
  apiVersion: "edict.lowering-requirements/v1",
  operationProfile: tstr,
  semanticEffects: [* semantic-effect-requirement],
  requiredWriteClasses: [* write-class],
  guardKinds: [* guard-kind],
  atomicity: atomicity-requirement,
  postconditionSupport: bool,
  obstructionCoordinates: [* tstr],
  footprintObligations: [* tstr],
  costObligations: [* tstr],
  opticContract: tstr,
}

semantic-effect-requirement = {
  coordinate: tstr,
  writeClass: write-class,
  guardKinds: [* guard-kind],
  obstructionCoordinates: [* tstr],
  footprintObligations: [* tstr],
  costObligations: [* tstr],
}

write-class = "none" / "read" / "create" / "ensure" / "append" /
              "replace" / "delete" / tstr
guard-kind = "precommit-atomic" / tstr
atomicity-requirement = "atomic" / tstr

; A genuine union: pure constructors carry no effect kind or failures; effect
; intrinsics must (EDICT-TARGET-INTRINSIC-CLASS-001). The schema enforces this,
; not a comment.

; The intrinsic's coordinate is the intrinsics map KEY, not a value field, so the
; key and coordinate can never disagree (EDICT-ABI-INTRINSIC-UNIQUE-001).
intrinsic = pure-intrinsic / effect-intrinsic

pure-intrinsic = {
  intrinsicClass: "pure",
  ; Pure contracts are monomorphic.
  typeParameters: [],
  ; Ceiling types: an operand of the same family with a narrower bound fits.
  argumentTypes: [* core-type-ref],
  returnType: core-type-ref,
  guardSupport: false,
  footprintTemplate: nonempty-text,
  costTemplate: nonempty-text,
  writeClass: "none",
  ; Semantic version of the constructor's contract; consumers require an
  ; exact version.
  contractVersion: nonempty-text,
  costRule: pure-cost-rule,
}

nonempty-text = tstr .regexp "(?s).+"

; Steps for one call: base plus, for each argument, its coefficient times the
; size bound the verified program establishes for that operand (a Bytes
; maximum or a List element maximum). The schema fixes the shape. For a
; required contract, admission additionally requires one coefficient per
; argument and a zero coefficient for every argument that is not Bytes or List.
pure-cost-rule = {
  base: uint,
  perArgumentMax: [* uint],
}

effect-intrinsic = {
  intrinsicClass: "effect",
  typeParameters: [* tstr],
  argumentTypes: [* core-type-ref],
  returnType: core-type-ref,
  effectKind: effect-kind,
  ; map keyed by failure coordinate (failure-ident); the failure coordinate is
  ; the key, not a value field, so uniqueness is structural
  ; (EDICT-ABI-FAILURE-UNIQUE-001).
  effectFailures: { * failure-ident => effect-failure-body },
  guardSupport: bool,
  footprintTemplate: tstr,
  costTemplate: tstr,
  writeClass: "read" / "create" / "ensure" / "append" / "replace" /
              "delete" / "custom",
  canParticipateInAtomicGuard: bool,
}

; A catalog v3 effect intrinsic: the v2 shape plus its cost template.
effect-intrinsic-v3 = {
  intrinsicClass: "effect",
  typeParameters: [* tstr],
  argumentTypes: [* core-type-ref],
  returnType: core-type-ref,
  effectKind: effect-kind,
  effectFailures: { * failure-ident => effect-failure-body },
  guardSupport: bool,
  footprintTemplate: tstr,
  costTemplate: tstr,
  writeClass: "read" / "create" / "ensure" / "append" / "replace" /
              "delete" / "custom",
  canParticipateInAtomicGuard: bool,
  effectCostRule: effect-cost-rule,
}

; effect-failure-body, effect-kind, authority-class, and core-type-ref are defined
; once in edict-common.cddl and assembled with this schema (EDICT-ABI-NODUP-001).
