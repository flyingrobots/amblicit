{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Amblicit",
  "scopeName": "source.amblicit",
  "fileTypes": [
    "amblicit"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.amblicit",
          "match": "//.*$"
        },
        {
          "name": "comment.block.amblicit",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.amblicit",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.amblicit",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "name": "constant.numeric.integer.amblicit",
      "match": "\\b[0-9]+(?:_[0-9]+)*(?:i32|i64|u32|u64)?\\b|\\b[0-9]+(?:_[0-9]+)*_"
    },
    "keywords": {
      "name": "keyword.control.amblicit",
      "match": "\\b(?:package|use|type|enum|variant|intent|returns|profile|implements|basis|footprint|budget|where|let|return|request|require|guarantee|assert|if|then|else|for|in|bounded|yield|match|shape|lawpack|target|core|capability|as|digest|fn|const|true|false)\\b"
    },
    "types": {
      "name": "entity.name.type.amblicit",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "name": "keyword.operator.amblicit",
      "match": "->|=>|==|!=|<=|>=|&&|\\|\\||=|<|>|\\+|-|\\*|/|%|!"
    },
    "punctuation": {
      "name": "punctuation.separator.amblicit",
      "match": "::|\\.\\.\\.|[;:,.@(){}\\[\\]]"
    },
    "identifiers": {
      "name": "variable.other.amblicit",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    }
  }
}
