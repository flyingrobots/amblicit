{
  "name": "amblicit-vscode",
  "displayName": "Amblicit",
  "description": "Syntax highlighting for Amblicit source files.",
  "version": "0.6.0-alpha.1",
  "publisher": "flyingrobots",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/flyingrobots/amblicit.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "amblicit",
    "syntax",
    "highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "amblicit",
        "aliases": [
          "Amblicit",
          "amblicit"
        ],
        "extensions": [
          ".amblicit"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "amblicit",
        "scopeName": "source.amblicit",
        "path": "./syntaxes/amblicit.tmLanguage.json"
      }
    ]
  }
}
